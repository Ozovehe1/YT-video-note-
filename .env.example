# ----- LLM (note generation) — via NVIDIA's OpenAI-compatible API -----
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
# Primary model, then a comma-separated fallback list. Generation tries them in
# order and automatically uses the first healthy one — so if a hosted model goes
# down on NVIDIA's side, notes keep generating with no change needed.
LLM_MODEL=deepseek-ai/deepseek-v4-flash
LLM_FALLBACK_MODELS=meta/llama-3.1-8b-instruct,meta/llama-3.3-70b-instruct,deepseek-ai/deepseek-v4-pro
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: force the note DRAFT onto a specific (usually stronger) model, with a
# bounded timeout + automatic fallback to LLM_MODEL. Left unset it uses LLM_MODEL.
# Note: the big models (v4-pro, llama-3.3-70b) are too slow for the 60s serverless
# limit on the free tier, so the default (flash) is recommended.
# LLM_DRAFT_MODEL=deepseek-ai/deepseek-v4-pro

# Model for the ONCE-per-note classify + speaker-role step (monologue vs dialogue and
# who the host/guest are). This runs off the per-chunk generation path, so a
# slower/smarter reasoning model is used by default — it's bounded (~40s) and falls back
# to LLM_MODEL if slow, gated (402/403), or down. Thinking is auto-disabled for
# deepseek/nemotron. Defaults to Nemotron 3 Ultra; set to LLM_MODEL's value to disable.
LLM_CLASSIFY_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Chunks-per-minute the note generator is allowed to start. Each chunk makes TWO
# model calls (for a dialogue: diarize speakers + write; for a monologue: write +
# copy-edit), so 15 ≈ 30 requests/min — under NVIDIA's ~40/min. Lower it if you open
# the app on multiple devices at once.
NEXT_PUBLIC_LLM_RPM=15

# ---- Supabase (accounts, history, reading progress) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key.
# No service-role/secret key is needed — Row-Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ---- Supadata (YouTube transcripts) ----
# https://supadata.ai — works from Vercel's IPs, unlike scraping YouTube directly.
SUPADATA_API_KEY=sd_...

# ---- YouTube Data API (search by title) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...
