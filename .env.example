# ----- Gemini (note generation) -----
# https://aistudio.google.com/
GEMINI_API_KEY=AQ...
# gemini-2.5-flash is on the free tier (~250 req/day). 2.5-pro is not practical
# on free (~50 req/day) — a single long video's chunks would exhaust it.
GEMINI_MODEL=gemini-2.5-flash

# Requests-per-minute the note generator is allowed to make. Free-tier
# gemini-2.5-flash is 5/min, so the app paces itself to this and waits on 429s.
# Raise it only if your key has a higher limit (paid tier / flash-lite).
NEXT_PUBLIC_GEMINI_RPM=5

# ---- Supabase (accounts, history, reading progress) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key.
# No service-role/secret key is needed — Row-Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ---- Supadata (YouTube transcripts) ----
# https://supadata.ai — works from Vercel's IPs, unlike scraping YouTube directly.
SUPADATA_API_KEY=sd_...

# ---- YouTube Data API (search by title) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...
