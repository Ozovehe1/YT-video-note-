# ---- Supabase (accounts, history, reading progress, audio storage) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key for the browser app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
# Service-role (secret) key — server-only. Used by the token-authed agent API and the Modal
# callback (/api/notes/asr-callback), which have no browser session and must bypass RLS. They're
# authenticated by the agent token / an HMAC signature instead. Never expose this to the client.
# Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- YouTube Data API (search by title + video metadata) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...

# ---- Audio pipeline (Modal) ----
# There is no LLM. The user's PHONE downloads the YouTube audio (residential IP, reliable) and
# uploads it to Supabase Storage; the app then hands Modal a short-lived signed URL to that audio.
# Modal transcribes + diarizes it with MOSS-Transcribe-Diarize and POSTs the speaker-labeled
# segments back to /api/notes/asr-callback. See agent/modal_asr.py.
#
# MODAL_TRANSCRIBE_URL: the deployed Modal endpoint (…/transcribe). Stable once deployed.
MODAL_TRANSCRIBE_URL=https://YOUR--verbatim-asr-transcribe.modal.run
# ASR_WEBHOOK_SECRET: a long random string, the SAME value as the Modal secret named `tailscale`
# (the name is legacy; only ASR_WEBHOOK_SECRET is read). Authenticates both directions
# (app→Modal trigger and Modal→app callback via HMAC).
ASR_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Section headings (OPTIONAL) ----
# A free Groq key turns the reader's "12:00 – 17:00" section headings into short descriptive
# titles. Get one at https://console.groq.com (free, no card).
#
# This does NOT make the note itself model-written. The model receives a ~150-word excerpt of each
# section and returns only a label; the transcript is still assembled deterministically from the
# ASR output, word for word. Leave this unset and everything works exactly as before, with time
# ranges as headings.
GROQ_API_KEY=gsk_...
