# ---- Claude (note generation) ----
# https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Supabase (accounts, history, reading progress) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key.
# No service-role/secret key is needed — Row-Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ---- Supadata (YouTube transcripts) ----
# https://supadata.ai — works from Vercel's IPs, unlike scraping YouTube directly.
SUPADATA_API_KEY=sd_...

# ---- YouTube Data API (search by title) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...
