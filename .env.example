# ----- LLM (note generation) — via NVIDIA's OpenAI-compatible API -----
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
# Primary model, then a comma-separated fallback list. Generation tries them in
# order and automatically uses the first healthy one — so if a hosted model goes
# down on NVIDIA's side, notes keep generating with no change needed.
LLM_MODEL=deepseek-ai/deepseek-v4-flash
LLM_FALLBACK_MODELS=meta/llama-3.1-8b-instruct,meta/llama-3.3-70b-instruct,deepseek-ai/deepseek-v4-pro
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Requests-per-minute the note generator is allowed to make. NVIDIA's limit is
# ~40/min, so 30 leaves headroom for the classify call and retry bursts. Lower it
# if you open the app on multiple devices at once (each generates independently).
NEXT_PUBLIC_LLM_RPM=30

# ---- Supabase (accounts, history, reading progress) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key for the app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
# Service-role (secret) key — used ONLY by the /api/agent/* routes, which authenticate
# the local helper by its agent token (no browser session) and so must bypass RLS.
# Server-only; never expose it to the client. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- YouTube Data API (search by title + video metadata) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...

# ---- Audio pipeline ----
# Audio is fetched + transcribed by the LOCAL HELPER (see agent/), which runs on your
# own machine (residential IP) with yt-dlp + your diarizing ASR. Nothing to set here —
# the helper is configured with its own env (VERBATIM_URL, VERBATIM_AGENT_TOKEN, ASR_URL,
# ASR_KEY). Generate an agent token in the app's Settings page.
