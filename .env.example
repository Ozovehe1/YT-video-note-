# ----- Gemini (note generation) -----
# https://aistudio.google.com/
GEMINI_API_KEY=AQ...
# Note generation model. flash-lite has a higher per-minute limit and its own
# free-tier quota bucket, so notes generate reliably. Set to "gemini-2.5-flash"
# for higher-quality prose (lower rate limit). Each model has a SEPARATE quota.
GEMINI_MODEL=gemini-2.5-flash-lite
# Classification (monologue vs dialogue) runs on its own model/bucket so it never
# competes with generation. Defaults to flash-lite; override only if you want to.
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite

# Requests-per-minute the note generator is allowed to make. flash-lite allows
# ~30/min; we pace conservatively and back off on 429s. Keep low if you open the
# app on multiple devices at once (each device generates independently).
NEXT_PUBLIC_GEMINI_RPM=10

# ---- Supabase (accounts, history, reading progress) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key.
# No service-role/secret key is needed — Row-Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ---- Supadata (YouTube transcripts) ----
# https://supadata.ai — works from Vercel's IPs, unlike scraping YouTube directly.
SUPADATA_API_KEY=sd_...

# ---- YouTube Data API (search by title) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...
