# ----- LLM (note generation) — via NVIDIA's OpenAI-compatible API -----
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
# Primary model, then a comma-separated fallback list. Generation tries them in
# order and automatically uses the first healthy one — so if a hosted model goes
# down on NVIDIA's side, notes keep generating with no change needed.
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_FALLBACK_MODELS=deepseek-ai/deepseek-v4-flash,meta/llama-3.1-8b-instruct,deepseek-ai/deepseek-v4-pro
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Requests-per-minute the note generator is allowed to make. NVIDIA's limit is
# ~40/min, so 30 leaves headroom for the classify call and retry bursts. Lower it
# if you open the app on multiple devices at once (each generates independently).
NEXT_PUBLIC_LLM_RPM=30

# ---- Supabase (accounts, history, reading progress) ----
# Project Settings → API. Use the URL and the *publishable* (anon) key.
# No service-role/secret key is needed — Row-Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ---- Supadata (YouTube transcripts) ----
# https://supadata.ai — works from Vercel's IPs, unlike scraping YouTube directly.
SUPADATA_API_KEY=sd_...

# ---- YouTube Data API (search by title) ----
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=AIza...
